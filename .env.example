# ─────────────────────────────────────────────────────────────
# PlacdAI environment variables
#
# HOW TO USE
#   1. Copy this file:      cp .env.example .env
#   2. Fill in the 4 values below.
#   3. Run:                  bun install && bun dev
#   4. Open:                 http://localhost:8080
#
# `.env` is git-ignored — never commit it.
# ─────────────────────────────────────────────────────────────


# ── 1. Supabase (server-side) ────────────────────────────────
# Where to find these:
#   Supabase dashboard → your project → Project Settings → API
#
# EXTERNAL_SUPABASE_URL          — "Project URL"
# EXTERNAL_SUPABASE_ANON_KEY     — "anon / public" key (safe-ish; RLS applies)
# EXTERNAL_SUPABASE_SERVICE_KEY  — "service_role" key
#     ⚠️  BYPASSES Row-Level Security. Server-only. NEVER commit,
#         NEVER expose to the browser, NEVER prefix with VITE_.
EXTERNAL_SUPABASE_URL=https://your-project-ref.supabase.co
EXTERNAL_SUPABASE_ANON_KEY=sb_publishable_xxx
EXTERNAL_SUPABASE_SERVICE_KEY=sb_secret_xxx


# ── 2. Supabase (browser-side) ───────────────────────────────
# Vite only exposes vars that start with VITE_ to the browser bundle.
# These are the SAME url + anon key as above, duplicated with the VITE_ prefix
# so the frontend Supabase client can read them.
VITE_EXTERNAL_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_EXTERNAL_SUPABASE_ANON_KEY=sb_publishable_xxx


# ── 3. Google Gemini (server-side) ───────────────────────────
# Get a free API key at:  https://aistudio.google.com/apikey
#
# Used for:
#   • Product picker JSON (always — cheap text call)
#   • Room image generation + product swaps (only when
#     USE_LOVABLE_GATEWAY = false in src/lib/gemini.server.ts)
#
# ⚠️  AFTER EXPORTING TO VSCODE:
#     Open src/lib/gemini.server.ts and set USE_LOVABLE_GATEWAY = false
#     so image generation uses your own GEMINI_API_KEY instead of the
#     Lovable AI Gateway (which only works inside Lovable).
GEMINI_API_KEY=your_gemini_api_key
